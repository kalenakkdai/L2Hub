# Environment and secrets
.env
.env.local
.env.*.local
# Student ID / password secrets for roster provisioning — never commit.
backend/data/roster_credentials.json
backend/data/roster_student_ids.json
# Any parked copy of a local env file, e.g. `.env.local.off` when
# switching back to the shared project. Renaming past the pattern above
# is what un-ignores these, so match them explicitly.
.env.local.*
!.env.local.example
*.pem
*.key

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Local SQLite databases
*.db
*.db.bak-*
*.sqlite
*.sqlite3

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Alembic / local runtime
backend/*.db
backend/.local-storage/
