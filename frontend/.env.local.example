# Local Supabase overrides. Copy to `.env.local` to point the frontend at the
# local stack; delete or rename `.env.local` to go back to the shared project.
#
#     cp frontend/.env.local.example frontend/.env.local
#
# Vite loads `.env` first and `.env.local` second, so this file only needs the
# keys that actually differ. `.env.local` is gitignored — it is per-machine.
#
# Fill the key from the `supabase start` output, or re-print it any time with:
#
#     supabase status -o env
#
# The local keys are not secret. They are fixed development credentials for a
# database on your own machine, and the local stack is not reachable from the
# internet. Treat them as throwaway; never reuse them anywhere else.

VITE_SUPABASE_URL=http://127.0.0.1:54321

# From `supabase status -o env` — ANON_KEY (older CLIs) or PUBLISHABLE_KEY.
# Do not paste SERVICE_ROLE_KEY here: anything VITE_-prefixed is bundled into
# the browser, and src/lib/supabase.ts refuses to start if it sees one.
VITE_SUPABASE_PUBLISHABLE_KEY=paste-the-local-key-here

# The local stack accepts the codes in [auth.sms.test_otp] in
# supabase/config.toml without sending anything, so the six-box phone flow
# works here. The shared project has no SMS provider, which is why `.env`
# leaves this false.
VITE_SMS_ENABLED=true
