# Copy this file to .env and adjust if needed.
# Never commit a real .env file with secrets.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Supabase -------------------------------------------------------------
# Needed in Phase 2, when the frontend login screen is built. Both values are
# safe to expose to the browser; the publishable key is protected by RLS, not
# by secrecy. Never put a secret key (sb_secret_... or service_role) in a
# VITE_ variable — anything VITE_-prefixed is bundled into the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
