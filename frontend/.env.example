# Copy this file to .env and adjust if needed.
# Never commit a real .env file with secrets.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Supabase -------------------------------------------------------------
# Both values are safe to expose to the browser; the publishable key is
# protected by RLS, not by secrecy. Never put a secret key (sb_secret_... or
# service_role) in a VITE_ variable — anything VITE_-prefixed is bundled into
# the client and readable by every visitor.
#
# This project uses Supabase's current key system. VITE_SUPABASE_ANON_KEY is
# the older name for the same thing; if you are following a guide that uses
# it, the publishable key is what it means.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# --- SMS ------------------------------------------------------------------
# Phone verification needs an SMS provider configured in the Supabase
# dashboard (Authentication -> Providers -> Phone). Until one is set up, leave
# this false: the Settings page then disables the SMS toggles and says why,
# rather than offering a flow that cannot complete.
VITE_SMS_ENABLED=false
