# Local Supabase overrides. Copy to `.env.local` to point the backend at the
# local stack; delete or rename `.env.local` to go back to the shared project.
#
#     cp backend/.env.local.example backend/.env.local
#
# app/core/config.py loads `.env` first and `.env.local` second, so this file
# only needs the keys that actually differ. `.env.local` is gitignored.
#
# Keep this in step with frontend/.env.local. If only one half is switched, the
# browser and the API end up on different databases and the failures look like
# missing rows rather than a misconfiguration.

SUPABASE_URL=http://127.0.0.1:54321

# The local Postgres, straight from `supabase status -o env` (DB_URL).
# Port 54322 is the default; check the output if you changed it in config.toml.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The local stack signs tokens with a fixed HS256 secret rather than JWKS.
# Take JWT_SECRET from `supabase status -o env`.
SUPABASE_JWT_SECRET=paste-the-local-jwt-secret-here
