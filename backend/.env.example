# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

# App
APP_NAME=L2 Hub
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# --- Supabase -------------------------------------------------------------
# Project URL from Supabase dashboard -> Project Settings -> API.
# Used to derive the JWKS endpoint and the expected token issuer.
SUPABASE_URL=https://your-project-ref.supabase.co

# Postgres connection string from Project Settings -> Database.
# Use the session pooler URI (port 5432) for normal use; the transaction
# pooler (port 6543) is detected automatically and pooling is disabled for it.
SUPABASE_DB_URL=postgresql://postgres:your-password@your-host:5432/postgres

# Only needed if your project still signs tokens with the legacy HS256 secret
# (dashboard -> Project Settings -> API -> JWT Settings). Projects using JWT
# signing keys can leave this blank — verification uses the JWKS endpoint.
SUPABASE_JWT_SECRET=

# Audience claim on Supabase access tokens. Leave as-is.
SUPABASE_JWT_AUDIENCE=authenticated

# Fallback database used only when SUPABASE_DB_URL is empty.
DATABASE_URL=sqlite:///./l2hub.db

# CORS — frontend origins during local development, comma-separated.
# Origins are matched as exact strings, so http://localhost:5173 and
# http://127.0.0.1:5173 are distinct entries even though Vite serves both.
# List every spelling you actually open in the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

# --- Object storage -------------------------------------------------------
# Call sites depend on ObjectStorage (DI), not a concrete folder or bucket.
# local    = files under STORAGE_LOCAL_ROOT on this machine. Development only:
#            a deployed container's filesystem is wiped on every deploy.
# supabase = private Supabase Storage bucket. Use this anywhere uploads are
#            meant to survive a restart — meeting recordings especially.
# s3/gcs   = reserved for a later AWS or Google Cloud bucket swap
STORAGE_BACKEND=local
# Leave empty to use backend/.local-storage, or set an absolute path, e.g.
# STORAGE_LOCAL_ROOT=/Users/you/L2Hub-storage
STORAGE_LOCAL_ROOT=

# Required only when STORAGE_BACKEND=supabase.
#
# This is the secret key (dashboard -> Project Settings -> API keys), NOT the
# publishable key the frontend uses. It bypasses RLS entirely, so it belongs in
# a secret store on the host and must never appear in a VITE_ variable or any
# other value that reaches the browser.
SUPABASE_SERVICE_KEY=
# Created by supabase/migrations/20260821000000_attachments_bucket.sql.
SUPABASE_STORAGE_BUCKET=attachments
# Lifetime of the signed URLs handed out by url_for(), in seconds.
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# --- Note Taker (optional Whisper fallback) -------------------------------
# Primary STT is Chrome Web Speech in the browser. Whisper is only used when
# an upload arrives without a transcript. Requires ffmpeg + openai-whisper.
# Model sizes: tiny, base, small, medium, large. base is the MVP default.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Attendance timing is server-authoritative.
ATTENDANCE_TIMEZONE=America/Los_Angeles
ATTENDANCE_CLASS_START=08:00
ATTENDANCE_CLASS_END=08:50
# Generate a long random value for deployed environments.
ATTENDANCE_ID_PEPPER=change-me

# Passkeys (Touch ID / Face ID stay on the student's device).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Optional parent-alert SMTP. Leave blank to retain alerts in the outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Deadline reminders ---------------------------------------------------
# Outbound email for board deadlines.
# `log`    — write the message to the log and send nothing. The default, and
#            what development should stay on: a reminder must never reach a
#            real student from a laptop.
# `resend` — POST to Resend. Needs RESEND_API_KEY and EMAIL_FROM.
EMAIL_BACKEND=log
RESEND_API_KEY=
# Must be a verified sender on the provider.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Frontend origin, used to link from an email back to the board.
APP_BASE_URL=http://localhost:5173

# Shared secret for the pg_cron/pg_net deadline sweep trigger. Must match the
# `l2hub_job_secret` value in Supabase Vault. Empty means the endpoint refuses
# every call with 503 rather than running unauthenticated.
JOB_TRIGGER_SECRET=

# How far back the sweep looks for tasks that already slipped. Stops the first
# run after a deploy raising an overdue notice for every task in history.
DEADLINE_BACKFILL_DAYS=14
